# Store secrets only on the backend host; never commit a real API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_UPLOAD_MB=10
MAX_API_BODY_MB=40
SESSION_TTL_SECONDS=7200
MAX_SESSIONS=50
# Exact frontend origin(s), comma-separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FLASK_DEBUG=false
